# ============================================================
# LLM (D1 — OpenAI SDK, custom endpoint + api_key)
# ============================================================
LLM_ENDPOINT=https://your-provider.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ============================================================
# OCR (D3 — RapidOCR EN, in-memory)
# ============================================================
OCR_LANG=en
OCR_MIN_CONFIDENCE=0.5

# ============================================================
# App
# ============================================================
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
MAX_UPLOAD_MB=10

# ============================================================
# Reserved for Phase 2+ (chưa dùng ở Phase 1)
# ============================================================
MILVUS_URI=./data/milvus_data/ai_debugger.db
STATIC_COLLECTION=static_database
DYNAMIC_COLLECTION=dynamic_database
MILVUS_INDEX_TYPE=FLAT              
MILVUS_METRIC_TYPE=COSINE           
EMBEDDING_BATCH_SIZE=16 
METADATA_DIR=./data/metadata
DOC_STORE_DIR=./data
DLQ_DIR=./data/dlq
TOP_K_PER_COLLECTION=5
TOP_N_FINAL=3
SCORE_THRESHOLD=0.30
DEDUP_THRESHOLD=0.95
CONFIDENCE_MIN=0.80
PROMPTS_DIR=./config/prompts  
PROMPTS_DIR=./config/prompts
SSE_HEARTBEAT_SECONDS=60            
MAX_IMAGE_BYTES=10485760            # (10 MB)
HISTORY_MAX_TURNS=3                 
SERVE_STATIC=true                   
STATIC_DIR=./frontend      
LEARNING_QUEUE_MAXSIZE=100            # NEW
LEARNING_CONFIDENCE_IGNORE=0.75       # NEW
LEARNING_CONFIDENCE_PROTECT=0.90      # NEW
STATIC_WEIGHT=0.7                     # NEW
DYNAMIC_WEIGHT=0.3                    # NEW         