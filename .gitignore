# Secrets - ignore local environment files but keep the example
.env
.env.*
!.env.example

# Python - ignore virtual environments, caches, and build artifacts
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Node - ignore installed dependencies and generated bundles
node_modules/

# Application data - ignore local Milvus database files
/data/milvus_data/

# Operating system - ignore Finder metadata
.DS_Store

# Local scratch files - keep generated demos and one-off scripts out of git
/demo.png
/document.html
/fix_jsonl.py
/test_llm.py
